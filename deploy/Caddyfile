# OPIC 官网 —— Caddy 站点配置
# 部署方式：把本文件拷到服务器（如 /etc/caddy/Caddyfile）或 Caddy 容器挂载。
# 域名：把 opic.example.com 替换为实际域名后使用；首个证书由 Caddy 自动申请。

opic.example.com {
	encode zstd gzip

	root * /srv/opic-website/public

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; font-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
	}

	# 文档区：oink 内部样式/脚本有少量 inline，放宽 CSP
	@docs path /docs/*
	header @docs {
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"
		defer
	}

	# 搜索索引不应缓存
	@search path /offline-search-index.*.json /llms*.txt /navigation.json
	header @search Cache-Control "no-store"

	# 静态资源长缓存
	@static path /assets/* /css/* /js/* /icons/*
	header @static Cache-Control "public, max-age=604800"

	file_server

	log {
		output file /var/log/caddy/opic.log
		format console
	}
}
